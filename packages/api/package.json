{
  "name": "@danfo/api",
  "version": "0.1.0",
  "description": "Express HTTP API, routes, middleware, and jobs for Danfo",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@danfo/core": "workspace:*",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^4.22.2",
    "helmet": "^8.0.0",
    "multer": "^2.1.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.19.37",
    "@types/ws": "^8.5.12",
    "tsx": "^4.7.0",
    "typescript": "~5.2.2"
  }
}
